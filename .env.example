# Copy to .env.local and fill in.

# Public URL of the site (used for share links, QR poster and link previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LOCKRZ WhatsApp number in international format without "+", e.g. 260971234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase project (Project Settings > API). Only the anon key is used by the website.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
